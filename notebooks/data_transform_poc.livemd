# Data Transform PoC

```elixir
Mix.install([:timex, :explorer, :vega_lite, :kino_vega_lite])
```

## Section

```elixir
period = 28
t_unit = 7
date_column_name = "date"

end_date = ~D[2022-07-11]
start_date = end_date |> Timex.shift(days: -(period - 1))
data_start_date = start_date |> Timex.shift(days: -t_unit * 2)

columns = ["date", "price_sum"]

rows =
  Date.range(data_start_date, end_date)
  |> Enum.with_index()
  |> Enum.map(fn {date, i} -> [date, i] end)

[data_start_date: data_start_date, start_date: start_date, end_date: end_date]
```

```elixir
date_range = Date.range(data_start_date, end_date)

map =
  rows
  |> Enum.map(fn row ->
    map = Enum.zip([columns, row]) |> Map.new()
    key = map[date_column_name]

    {key, map}
  end)
  |> Map.new()
  # to check fill_missing works
  |> Map.delete(~D[2022-07-05])

map =
  date_range
  |> Enum.reduce(map, fn date, map ->
    case Map.has_key?(map, date) do
      true ->
        map

      false ->
        empty_data =
          columns
          |> Enum.map(fn column ->
            case column do
              ^date_column_name -> {date_column_name, date}
              _ -> {column, nil}
            end
          end)
          |> Map.new()

        map |> Map.put(date, empty_data)
    end
  end)

df =
  map
  |> Map.values()
  |> Enum.sort_by(fn %{"date" => date} -> date end, {:asc, Date})
  |> Explorer.DataFrame.new()

columns =
  df
  |> Explorer.DataFrame.mutate(%{
    "price_sum" => &Explorer.Series.fill_missing(&1["price_sum"], :forward)
  })
  |> Explorer.DataFrame.mutate(%{"price_sum" => &Explorer.Series.fill_missing(&1["price_sum"], 0)})
  |> Explorer.DataFrame.mutate(%{"t7_sum" => &Explorer.Series.window_sum(&1["price_sum"], 7)})
  |> Explorer.DataFrame.mutate(%{
    "t7_sum-7d" => fn df ->
      Explorer.Series.concat(Explorer.Series.from_list(List.duplicate(nil, t_unit)), df["t7_sum"])
      |> Explorer.Series.head(Explorer.Series.size(df["t7_sum"]))
    end
  })
  |> Explorer.DataFrame.mutate(%{
    "t7_sum_wow" => fn df ->
      Explorer.Series.divide(df["t7_sum"], df["t7_sum-7d"])
    end
  })
  |> Explorer.DataFrame.tail(period)
  |> Explorer.DataFrame.to_columns()

headers = ["date", "price_sum", "t7_sum", "t7_sum-7d", "t7_sum_wow"]
data = headers |> Enum.map(&(columns |> Map.get(&1)))

%{headers: headers, data: data}
```

```elixir
alias VegaLite, as: Vl

dates = data |> Enum.at(0) |> Enum.map(&(&1 |> Date.to_iso8601()))
t7_sum = data |> Enum.at(2)
t7_sum_7d = data |> Enum.at(3)

Vl.new()
|> Vl.data_from_values(date: dates, t7_sum: t7_sum, t7_sum_7d: t7_sum_7d)
|> Vl.transform(fold: ["t7_sum", "t7_sum_7d"])
|> Vl.encode_field(:x, "date")
|> Vl.layers([
  Vl.new()
  |> Vl.encode_field(:y, "value", type: :quantitative)
  |> Vl.encode_field(:color, "key", type: :nominal, title: nil)
  |> Vl.layers([
    Vl.new()
    |> Vl.mark(:line),
    Vl.new()
    |> Vl.mark(:point, tooltip: true)
  ])
])
```
