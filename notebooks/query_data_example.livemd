# QueryData Example

```elixir
nil
```

## Section

```elixir
sql_template = """
SELECT DATE(datetime) as date, SUM(price) AS price_sum --, AVG(price) AS price_avg
    FROM orders
    WHERE datetime >= {{start}} AND datetime < {{end}}
      AND datetime 
    GROUP BY date
    ORDER BY date
"""

datetime = ~U[2022-07-08 00:00:00Z]
timezone = "Asia/Seoul"
period = 28
window_size = 7
comparing_period = 7
limit = 5
```

```elixir
{:ok, %{columns: columns, data: data}} =
  Carrier.Data.QueryData.query_sample(%{
    org_id: 1,
    conn_info_id: 1,
    sql_template: sql_template,
    datetime: datetime,
    timezone: timezone,
    period: period,
    limit: limit
  })
```

```elixir
Kino.DataTable.new(data)
```

```elixir
{:ok, %{columns: columns, data: data}} =
  Carrier.Data.QueryData.query(%{
    org_id: 1,
    conn_info_id: 1,
    sql_template: sql_template,
    datetime: datetime,
    timezone: timezone,
    period: period,
    window_size: window_size,
    comparing_period: comparing_period
  })
```

```elixir
Kino.DataTable.new(data)
```

```elixir
alias VegaLite, as: Vl

data =
  data
  |> Enum.map(fn datum -> Map.update!(datum, "date", &Date.to_iso8601/1) end)

Vl.new()
|> Vl.data_from_values(data)
|> Vl.transform(fold: ["price_sum_window_sum", "price_sum_window_sum_offset"])
|> Vl.encode_field(:x, "date")
|> Vl.layers([
  Vl.new()
  |> Vl.encode_field(:y, "value", type: :quantitative)
  |> Vl.encode_field(:color, "key", type: :nominal, title: nil)
  |> Vl.layers([
    Vl.new()
    |> Vl.mark(:line),
    Vl.new()
    |> Vl.mark(:point, tooltip: true)
  ])
])
|> Vl.to_spec()
|> Jason.encode!()
|> IO.puts()
```
