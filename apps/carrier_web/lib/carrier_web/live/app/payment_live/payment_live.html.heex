<section class="page-container">
  <header class="page-header">
    <h1 class="page-title">
      <span class="page-title-icon">💳</span> 플랜 선택하기
    </h1>
  </header>

  <div class="mt-6 grid grid-cols-12 gap-4">
    <div class="col-span-8 card">
      <div class="card-body">
        <h2 class="card-title">
          플랜
        </h2>

        <div>
          <div class="mb-10">한 달 동안 무료로 사용하고 언제든지 해지하세요.</div>

          <%= for plan <- @plans do %>
            <div
              class="py-4 px-6 mt-2 cursor-pointer rounded w-full border hover:bg-black hover:text-white flex items-center justify-between bg-white text-black"
              phx-click={JS.push("select_plan", value: %{plan_id: plan.id})}
            >
              <div class="flex items-center">
                <div>
                  <input type="radio" class="radio mr-4" checked={@selected_plan.id == plan.id} />
                </div>
                <div>
                  <div class="font-bold text-lg"><%= plan.name %></div>
                  <div class="font-bold"><%= plan.price %> 원 / 월</div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-span-4 card">
      <div class="card-body">
        <h2 class="card-title">
          결제 정보
        </h2>
        <div>
          <%= @selected_plan.name %>
        </div>
        <div>
          <%= @selected_plan.payment_description %>
        </div>
        <button class="btn btn-primary mt-6 w-full" type="button" phx-click="request_payment">
          결제하기
        </button>
      </div>
    </div>
  </div>
</section>
