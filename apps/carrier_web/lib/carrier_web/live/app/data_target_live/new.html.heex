<div class="page-container">
  <.page_header icon="⚙️" title={@title} />

  <.card_container>
    <.card>
      <div class="callout">
        <.icon name="hero-exclamation-circle" class="mr-2.5" /> 슬랙 토큰이 만료되었습니다. 다시 한 번 연결해주세요.
      </div>

      <div class="mt-4">
        <Slack.button redirect_uri={@redirect_uri} />
      </div>
    </.card>
  </.card_container>
</div>
