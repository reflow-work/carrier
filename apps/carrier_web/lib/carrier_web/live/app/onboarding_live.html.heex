<section class="h-screen flex flex-col items-center pt-16">
  <div class="text-2xl font-bold">🏢 회사 정보 입력하기</div>
  <div class="mt-6 text-landingDescription text-center text-sm leading-6">
    reflow에 오신 걸 환영합니다! 🎉<br />회사 정보만 입력하면 복잡한 설정 없이 바로 reflow를 경험해볼 수 있습니다.
  </div>

  <div class="mt-8">
    <.simple_form
      :let={f}
      for={%{}}
      as={:onboarding}
      phx-change="validate_onboarding"
      phx-submit="update_onboarding"
      class="max-w-xs w-80"
    >
      <.input label="회사 이름" type="text" field={f[:name]} placeholder="리플로우" />

      <.input label="회사 업종" type="select" field={f[:industry]} options={Org.industries()} />

      <.input
        label="회사 직원수"
        type="select"
        field={f[:employee_count]}
        options={Org.employee_counts()}
      />

      <.input label="직무" type="select" field={f[:position]} options={User.positions()} />

      <div>
        <.input id="agreed_terms_of_service" type="checkbox" field={f[:agreed_terms_of_service]}>
          <:label_element>
            <a href={Const.get(:terms_of_service_url)} target="_blank" class="underline">
              이용약관
            </a>
            에 동의합니다.
          </:label_element>
        </.input>

        <.input id="agreed_privacy_policy" type="checkbox" field={f[:agreed_privacy_policy]}>
          <:label_element>
            <a href={Const.get(:privacy_policy_url)} target="_blank" class="underline">
              개인정보 처리방침
            </a>
            에 동의합니다.
          </:label_element>
        </.input>
      </div>

      <:actions>
        <div class="w-full">
          <.button
            class="w-full"
            phx-disable-with="가입중"
            phx-click={js_log_event("click_submit_onboarding", %{page_name: "onboarding"})}
          >
            7일 무료 트라이얼 시작하기
          </.button>
          <p class="mt-2 text-sm text-center">필요 시 문의주시면 트라이얼 연장이 가능합니다.</p>
        </div>
      </:actions>
    </.simple_form>
  </div>
</section>
