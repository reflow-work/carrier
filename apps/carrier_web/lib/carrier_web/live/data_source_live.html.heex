<header>
  <h1 class="text-4xl font-bold">
    Connect Data Source
  </h1>
</header>

<section class="mt-10">
  <div class="bg-white rounded-md p-5">

    <div class="text-sm breadcrumbs">
      <ul>
        <li>
          <a
            phx-click="change_step"
            phx-value-step="step-1"
          >
            <Icon.folder />
            1. Select Data Source
          </a>
        </li>
        <li>
          <a
            phx-click="change_step"
            phx-value-step="step-2"
          >
            <Icon.folder />
            2. Set up Connection
          </a>
        </li>
      </ul>
    </div>

    <%= if @step == "step-1" do %>
      <div class="mt-10 space-y-4">
        <div
          phx-click="select_source"
          phx-value-source="mysql"
          class="border p-4 cursor-pointer rounded hover:bg-gray-100"
        >
          MySQL
        </div>
        <div phx-click="select_source" phx-value-source="postgres" class="border p-4 cursor-pointer rounded hover:bg-gray-100"}>
          PostgreSQL
        </div>
      </div>
    <% end %>

    <%= if @step == "step-2" do %>
      <div class="mt-10">
        <.form let={f} for={:conn_info} phx-submit="create_conn_info" class="space-y-2">
          <div>
            <label class="label">
              <span class="label-text">Name</span>
            </label>
            <%= text_input(f, :name, class: "data-source-input", placeholder: "Type here") %>
          </div>

          <div>
            <label class="label">
              <span class="label-text">Host</span>
            </label>
            <%= text_input(f, :hostname, class: "data-source-input", placeholder: "Type here") %>
          </div>

          <div>
            <label class="label">
              <span class="label-text">Port</span>
            </label>
            <%= text_input(f, :port, class: "data-source-input", placeholder: "Type here") %>
          </div>

          <div>
            <label class="label">
              <span class="label-text">Database</span>
            </label>
            <%= text_input(f, :database, class: "data-source-input", placeholder: "Type here") %>
          </div>

          <div>
            <label class="label">
              <span class="label-text">Username</span>
            </label>
            <%= text_input(f, :username, class: "data-source-input", placeholder: "Type here") %>
          </div>

          <div>
            <label class="label">
              <span class="label-text">Password</span>
            </label>
            <%= password_input(f, :password, class: "data-source-input", placeholder: "Type here") %>
          </div>

          <div class="flex justify-end pt-4">
            <%= submit "Connect", class: "btn" %>
          </div>
        </.form>
      </div>
    <% end %>
  </div>
</section>
