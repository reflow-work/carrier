<header>
  <h1 class="text-4xl font-bold">
    Connect Data Source
  </h1>
</header>

<section class="mt-10">
  <div class="bg-white rounded-md p-5">

    <div class="text-sm breadcrumbs">
      <ul>
        <li>
          <a>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4 mr-2 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
            1. Select Data Source
          </a>
        </li> 
        <li>
          <a>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4 mr-2 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
            2. Set up Connection
          </a>
        </li> 
      </ul>
    </div>

    <div class="mt-10 space-y-4">
      <div 
        phx-click="select_source" 
        phx-value-source="mysql" 
        class={"border p-4 cursor-pointer rounded hover:bg-gray-100 #{if @source == "mysql" do "border-cyan-500 bg-cyan-50 hover:bg-cyan-100" end}"}
      >
        MySQL
      </div>
      <div phx-click="select_source" phx-value-source="postgresql" class={"border p-4 cursor-pointer rounded hover:bg-gray-100 #{if @source == "postgresql" do "border-cyan-500 bg-cyan-50 hover:bg-cyan-100" end}"}>
        PostgreSQL
      </div>
    </div>
  </div>
</section>
