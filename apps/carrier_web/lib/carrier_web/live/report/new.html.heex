<section class="page-container">
  <header class="page-header">
    <h1 class="page-title">
      <span class="page-title-icon">📊</span> Create New Report
    </h1>
  </header>

  <section class="mt-6 space-y-6">
    <section class="card">
      <div class="card-body">
        <h2 class="card-title">Type Query</h2>
        <.form :let={f} for={:query} id="query_form" phx-submit="run_query" autocomplete="off">
          <div class="flex-col gap-2 sm:grid sm:grid-cols-5 sm:gap-2">
            <%= textarea(f, :sql_template,
              class: "border rounded mt-2 p-2 w-full sm:col-span-3",
              placeholder: "SQL here",
              value: @sql_template,
              rows: 20
            ) %>
            <section class="bg-base rounded mt-2 p-4 w-full sm:col-span-2 text-body2">
              <p>
                기준점이 되는 날짜 컬럼과 주요 지표 컬럼을 이용하여 GROUP BY를 이용한 집계 쿼리로 작성해주세요.
              </p>
              <p class="mt-2">
                날짜 조건은 아래 3,4번 규칙에 따라 입력하면 구체적인 계산은 자동으로 수행됩니다.
              </p>
              <p class="mt-2">주요 지표는 3개까지 설정 가능합니다.</p>
              <ul class="divide-y divide-gray-200 border-t border-b border-gray-200 mt-4">
                <li class="py-2 flex items-center gap-x-2">
                  <CarrierWeb.Components.Icon.check_black class="w-6 h-6 flex-shrink-0" />
                  SELECT문의 첫번째 컬럼이 기준 날짜가 됩니다. date타입으로 지정해주세요.
                </li>
                <li class="py-2 flex items-center gap-x-2">
                  <CarrierWeb.Components.Icon.check_black class="w-6 h-6 flex-shrink-0" />
                  두번째 컬럼부터는 집계(컬럼명) as "표시명" 으로 입력해주세요.
                </li>
                <li class="py-2 flex items-center gap-x-2">
                  <CarrierWeb.Components.Icon.check_black class="w-6 h-6 flex-shrink-0" />
                  <%= ~s(시작날짜 조건에는 {{start}} 를 넣어주세요.) %>
                </li>
                <li class="py-2 flex items-center gap-x-2">
                  <CarrierWeb.Components.Icon.check_black class="w-6 h-6 flex-shrink-0" />
                  <%= ~s(종료날짜 조건 에는 {{end}} 를 넣어주세요.) %>
                </li>
              </ul>
              <pre class="border-1 border-gray-200 p-2 bg-gray-200 rounded mt-6">
<code>-- 예시</code>
<code>SELECT</code>
<code>  date(create_time),</code>
<code>  count(distinct used_id) as "결제자수",</code>
<code>  sum(revenue) as "매출"</code>
<code>FROM</code>
<code>  transactions</code>
<code>WHERE <%= ~s(create_time > {{start}}) %></code>
<code>  <%= ~S(AND create_time < {{end}}) %></code>
<code>GROUP BY 1</code>
</pre>
            </section>
          </div>
          <div class="text-right mt-2">
            <%= submit("Run Query", class: "btn btn-primary") %>
          </div>
        </.form>
      </div>
    </section>

    <%= if @query_result_for_preview do %>
      <section class="card">
        <div class="card-body">
          <header class="flex justify-between">
            <h2 class="card-title">쿼리 결과 데이터</h2>
            <button
              class="btn btn-outline btn-sm"
              type="button"
              phx-click="toggle_show_full_preview_data"
            >
              <%= if @show_full_preview_data do %>
                숨기기
              <% else %>
                전체 보기
              <% end %>
            </button>
          </header>
          <table class="border-collapse border border-gray-800">
            <thead>
              <tr class="w-full">
                <%= for header <- @query_result_for_preview.columns do %>
                  <th class="border border-gray-800"><%= header %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <%= if @show_full_preview_data do %>
                <%= for row <- @query_result_for_preview.data do %>
                  <tr class="w-full">
                    <%= for value <- row do %>
                      <td class="border border-gray-800 text-center"><%= value %></td>
                    <% end %>
                  </tr>
                <% end %>
              <% else %>
                <%= for row <- Enum.take(@query_result_for_preview.data, 5) do %>
                  <tr class="w-full">
                    <%= for value <- row do %>
                      <td class="border border-gray-800 text-center"><%= value %></td>
                    <% end %>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>

    <section class="flex gap-4 flex-col lg:flex-row">
      <section class="card flex-[3_3_0%]">
        <div class="card-body">
          <h2 class="card-title">Set up Report</h2>
          <section>
            <h3 class="text-h3">Columns</h3>
            <%= if @query_result_by_columns do %>
              <.form
                :let={f}
                for={:data_columns}
                phx-change="select_data_column"
                class="flex flex-col gap-y-3 mt-4"
              >
                <%= for column <- Enum.filter(@query_result_raw.columns, &(&1 !== "date")) do %>
                  <div class="flex gap-x-2 items-center">
                    <%= checkbox(f, column, value: Enum.member?(@selected_columns, column)) %>
                    <%= label(f, column, column) %>
                  </div>
                <% end %>
              </.form>
            <% else %>
              <div class="pt-6">
                <Empty.empty
                  title="쿼리 결과가 없습니다."
                  description="확인할 데이터를 쿼리해주세요."
                />
              </div>
            <% end %>
          </section>
          <section>
            <h3 class="text-h3">Window Size</h3>
            <%= if @query_result_by_columns do %>
              <.form
                :let={f}
                for={:data_window_size}
                phx-change="select_window_size"
                class="flex flex-col gap-y-3 mt-4"
                phx-update="ignore"
              >
                <%= for window_size <- @window_sizes do %>
                  <div class="flex gap-x-2 items-center">
                    <%= radio_button(f, :window_size, window_size,
                      checked: @window_size == window_size
                    ) %>
                    <%= label(f, "window_size_#{window_size}", "Window Size: #{window_size}") %>
                  </div>
                <% end %>
              </.form>
            <% else %>
              <div class="pt-6">
                <Empty.empty
                  title="쿼리 결과가 없습니다."
                  description="확인할 데이터를 쿼리해주세요."
                />
              </div>
            <% end %>
          </section>
        </div>
      </section>

      <section class="card flex-[5_5_0%]">
        <div class="card-body">
          <h2 class="card-title">Slack Preview</h2>
          <%= if @query_result_by_columns do %>
            <div class="flex flex-col gap-y-6 mt-4">
              <%= for column <- Enum.filter(@query_result_raw.columns, &(&1 !== "date")) do %>
                <%= if Enum.member?(@selected_columns, column) do %>
                  <section class="border-l-2 border-gray-200 py-2 pl-4 font-lato text-slackBody">
                    <h3 class="text-xl font-bold pb-2">
                      📊 <%= "#{@query_result_by_columns[column].meta.label} (#{DateTime.now("Asia/Seoul") |> elem(1) |> DateTime.to_date() |> Date.to_string()})" %>
                    </h3>
                    <div class="grid grid-cols-2 gap-x-2">
                      <section class="border border-gray-200 p-4 rounded-lg flex flex-col gap-y-2">
                        <h4 class="text-xl font-bold">어제</h4>
                        <p class="text-center text-3xl font-bold">
                          <%= format_number(
                            @query_result_by_columns[column].meta.current_period_last_tick_raw
                          ) %>
                        </p>
                        <p class="text-xl text-center">
                          <span>지난 주 대비:</span>
                          <span class={[
                            "font-bold",
                            value_color(
                              @query_result_by_columns[column].meta.diff_between_period_raws
                            )
                          ]}>
                            <%= format_number(
                              @query_result_by_columns[column].meta.diff_between_period_raws
                            ) %>
                          </span>
                        </p>
                      </section>
                      <section class="border border-gray-200 p-4 rounded-lg flex flex-col gap-y-2">
                        <h4 class="text-xl font-bold">최근 7일 합계</h4>
                        <p class="text-center text-3xl font-bold">
                          <%= format_number(
                            @query_result_by_columns[column].meta.current_period_sum
                          ) %>
                        </p>
                        <p class="text-xl text-center">
                          <span>WOW:</span>
                          <span class={[
                            "font-bold",
                            value_color(
                              @query_result_by_columns[column].meta.diff_between_period_sums_in_percentage
                            )
                          ]}>
                            <%= wow_text(
                              @query_result_by_columns[column].meta.diff_between_period_sums_in_percentage
                            ) %>
                          </span>
                        </p>
                      </section>
                    </div>
                    <section
                      id={"chart-container-#{@query_result_by_columns[column].meta.label}"}
                      phx-update="ignore"
                      class="pt-2"
                    >
                      <canvas
                        id={"chart-#{@query_result_by_columns[column].meta.label}"}
                        class="border border-gray-200 rounded-lg"
                        phx-hook="Chart"
                      >
                      </canvas>
                    </section>
                  </section>
                <% else %>
                  <div></div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="pt-6">
              <Empty.empty
                title="쿼리 결과가 없습니다."
                description="확인할 데이터를 쿼리해주세요."
              />
            </div>
          <% end %>
        </div>
      </section>
    </section>

    <section class="card">
      <div class="card-body">
        <h2 class="card-title">Report Details</h2>
        <.form
          :let={f}
          for={:report}
          id="report_form"
          phx-submit="save_report"
          phx-change="validate"
          autocomplete="off"
          class="space-y-4"
        >
          <div class="flex items-center gap-x-2 mt-4">
            <%= label(f, :name, "레포트 이름", class: "label w-28 text-gray-500 text-sm") %>
            <%= text_input(f, :name,
              placeholder: "데일리 유저 지표",
              class: "input input-bordered w-64"
            ) %>
            <%= error_tag(f, :name) %>
          </div>

          <div class="flex items-center gap-x-2">
            <%= label(f, :hour, "레포트 발송 시간", class: "label w-28 text-gray-500 text-sm") %>
            <%= select(f, :hour, @hours, class: "select select-bordered w-64") %>
            <%= error_tag(f, :hour) %>
          </div>

          <div class="flex items-center gap-x-2">
            <%= label(f, :channel, "레포트 발송 채널", class: "label w-28 text-gray-500 text-sm") %>
            <%= select(f, :channel, @channels, class: "select select-bordered w-64") %>
            <%= error_tag(f, :channel) %>
          </div>

          <div class="flex gap-x-4 justify-end">
            <button class="btn btn-outline" type="button" phx-click="show_preview_modal">
              테스트 발송
            </button>
            <%= submit("레포트 저장", class: "btn btn-primary", disabled: !@is_report_valid) %>
          </div>
        </.form>
      </div>
    </section>
  </section>
</section>

<%= if @show_preview_modal == true do %>
  <.modal return_to={Routes.report_new_path(@socket, :new)}>
    <div>
      <h3 class="font-bold text-lg">테스트 발송</h3>
      <.form
        :let={f}
        for={:send_preview_form}
        id="send_preview_form"
        phx-submit="send_preview"
        autocomplete="off"
        class="space-y-4"
      >
        <div class="flex items-center gap-x-2">
          <%= label(f, :channel, "레포트 발송 채널", class: "label w-28 text-gray-500 text-sm") %>
          <%= select(f, :channel, @channels, class: "select select-bordered w-64") %>
          <%= error_tag(f, :channel) %>
        </div>
        <div class="flex justify-end">
          <%= submit("발송", class: "btn btn-primary text-right") %>
        </div>
      </.form>
    </div>
  </.modal>
<% end %>
