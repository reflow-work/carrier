<section class="page-container">
  <header class="page-header">
    <h1 class="page-title">
      <span class="page-title-icon">📊</span> 레포트 생성하기
    </h1>
  </header>

  <section class="mt-6 space-y-6">
    <section class="card">
      <div class="card-body">
        <div class="flex justify-between">
          <div>
            <h2 class="card-title mb-3">쿼리 입력하기</h2>
            <div>
              ☝️ 기준이 되는 날짜 컬럼과 보고 싶은 지표 컬럼(최대 3개)을 쿼리해주세요.
            </div>
          </div>

          <label for="query-maker" class="btn btn-primary ml-2" phx-click="open_query_maker">
            <CarrierWeb.Components.Icon.package class="w-6 h-6 mr-3" /> 간단한 쿼리 자동 입력기
          </label>
        </div>

        <.form
          :let={f}
          for={:query}
          phx-change="validate_query"
          phx-submit="run_query"
          autocomplete="off"
        >
          <div class="flex-col gap-2 sm:grid sm:grid-cols-7 sm:gap-2 pt-2">
            <div class="sm:col-span-4">
              <%= textarea(f, :sql_template,
                class: "border rounded query w-full",
                placeholder: @sample_sql_template,
                value: @sql_template,
                rows: 16
              ) %>
              <%= if @query_error_message do %>
                <div class="text-red-500 text-sm mt-1">
                  <%= @query_error_message %>
                </div>
              <% end %>
            </div>
            <section class="w-full px-2 sm:col-span-3 text-sm">
              <div class={"flex items-center shadow py-3 px-3 rounded border-l-8 #{if @query_validations.contains_start, do: "border-l-green-600", else: "border-l-red-600"}"}>
                <div class="mr-3 text-base">
                  <%= if @query_validations.contains_start do %>
                    <CarrierWeb.Components.Icon.check_circle class="w-6 h-6 text-green-600" />
                  <% else %>
                    <CarrierWeb.Components.Icon.x_circle class="w-6 h-6 text-red-600" />
                  <% end %>
                </div>
                <div>
                  <b>기간 시작 조건</b>에 실제 날짜가 아닌 <code class="code">{{start}}</code>를 넣어주세요.
                </div>
              </div>

              <div class={"flex items-center shadow py-3 px-3 rounded border-l-8 mt-4 #{if @query_validations.contains_end, do: "border-l-green-600", else: "border-l-red-600"}"}>
                <div class="mr-3 text-base">
                  <%= if @query_validations.contains_end do %>
                    <CarrierWeb.Components.Icon.check_circle class="w-6 h-6 text-green-600" />
                  <% else %>
                    <CarrierWeb.Components.Icon.x_circle class="w-6 h-6 text-red-600" />
                  <% end %>
                </div>
                <div>
                  <b>기간 종료 조건</b>에 실제 날짜가 아닌 <code class="code">{{end}}</code>를 넣어주세요.
                </div>
              </div>

              <div class="bg-yellow-50 rounded p-3 mt-3">
                <b>📌 Check point</b>

                <p class="mt-2">
                  - SELECT문의 첫 번째 컬럼에 <b>DATE 타입</b>의 기준이 되는 날짜 컬럼을 넣어주세요.
                </p>

                <p class="mt-2">
                  - SELECT문의 두 번째 컬럼부터는 <b>지표 컬럼</b>을 넣어주세요.
                </p>

                <p class="mt-2">
                  - <code class="code">AS "표시할 이름"</code>을 통해 지정한 지표 컬럼의 이름대로 레포트 제목이 생성됩니다.
                </p>

                <p class="mt-2">
                  - 집계된 데이터가 담긴 테이블이 아닌 경우 기준이 되는 날짜로 GROUP BY한 집계 쿼리를 작성해주세요.
                </p>
              </div>
            </section>
          </div>
          <div class="text-right mt-2">
            <%= submit("쿼리 실행",
              class: "btn btn-primary",
              disabled: !is_valid_sql_template(@query_validations)
            ) %>
          </div>
        </.form>
        <%= render_query_preview(assigns) %>
      </div>
    </section>

    <div>
      <.form
        :let={f}
        for={@report_changeset}
        as={:report}
        phx-change="validate_report"
        phx-submit="save_report"
        autocomplete="off"
      >
        <%= hidden_input(f, :org_id) %>
        <%= hidden_input(f, :user_id) %>

        <div class="space-y-6">
          <section class="flex gap-4 flex-col lg:flex-row">
            <section class="card flex-[3_3_0%]">
              <div class="card-body">
                <section>
                  <h2 class="card-title">레포트 설정</h2>
                  <section>
                    <h3 class="font-bold mt-6">레포트를 발송할 지표</h3>
                    <%= if @data_loaded do %>
                      <div class="flex flex-col gap-y-3 mt-2">
                        <%= inputs_for f, :data_source_info, fn fdsi -> %>
                          <%= hidden_input(fdsi, :data_source_id) %>
                          <%= hidden_input(fdsi, :sql_template) %>
                          <%= hidden_input(fdsi, :timezone) %>
                          <%= hidden_input(fdsi, :period) %>
                          <%= hidden_input(fdsi, :comparing_period) %>

                          <%= for column <- @columns do %>
                            <div class="flex gap-x-2 items-center">
                              <input
                                type="checkbox"
                                name="report[data_source_info][columns][]"
                                value={column}
                                checked={column in input_value(fdsi, :columns)}
                              />
                              <%= label(fdsi, :columns, column) %>
                            </div>
                          <% end %>
                        <% end %>
                      </div>
                    <% else %>
                      <div class="pt-6">
                        <Empty.empty
                          title="쿼리 결과가 없습니다."
                          description="확인할 데이터를 쿼리해주세요."
                        />
                      </div>
                    <% end %>
                  </section>
                </section>
                <section>
                  <h3 class="font-bold mt-10">그래프 값 옵션</h3>
                  <%= if @data_loaded do %>
                    <div class="flex flex-col mt-2">
                      <%= inputs_for f, :data_source_info, fn fdsi -> %>
                        <div class="flex gap-x-2 items-center">
                          <%= radio_button(fdsi, :window_size, 1,
                            class: "radio",
                            phx_click: "select_window_size"
                          ) %>
                          <%= label(f, :window_size, "당일 지표") %>
                        </div>
                        <div class="text-sm text-gray-500 ml-6 mt-1">
                          당일의 지표를 추가적인 집계 없이 그래프에 표시합니다.
                        </div>

                        <div class="flex gap-x-2 items-center mt-4">
                          <%= radio_button(fdsi, :window_size, 7,
                            class: "radio",
                            phx_click: "select_window_size"
                          ) %>
                          <%= label(f, :window_size, "이동합계") %>
                        </div>
                        <div class="text-sm text-gray-500 ml-6 mt-1">
                          요일별 추이를 제거하고 보기위해 최근 7일간의 합계로 그래프에 표시합니다.
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="pt-6">
                      <Empty.empty
                        title="쿼리 결과가 없습니다."
                        description="확인할 데이터를 쿼리해주세요."
                      />
                    </div>
                  <% end %>
                </section>
              </div>
            </section>

            <section class="card flex-[5_5_0%]">
              <div class="card-body">
                <h2 class="card-title">슬랙 미리보기</h2>
                <%= if @data_loaded do %>
                  <div class="flex flex-col gap-y-6 mt-4">
                    <%= for column <- @columns do %>
                      <%= inputs_for f, :data_source_info, fn fdsi -> %>
                        <section class={"border-l-2 border-gray-200 py-2 pl-4 font-lato text-slackBody #{if column not in input_value(fdsi, :columns), do: "hidden"}"}>
                          <h3 class="text-xl font-bold pb-2">
                            📊 <%= "#{@query_result_by_columns[column].meta.label} (#{DateTime.now("Asia/Seoul") |> elem(1) |> DateTime.to_date() |> Date.to_string()})" %>
                          </h3>
                          <div class="grid grid-cols-2 gap-x-2">
                            <section class="border border-gray-200 p-4 rounded-lg flex flex-col gap-y-2">
                              <h4 class="text-xl font-bold">어제</h4>
                              <p class="text-center text-3xl font-bold">
                                <%= format_number(
                                  @query_result_by_columns[column].meta.current_period_last_tick_raw
                                ) %>
                              </p>
                              <p class="text-xl text-center">
                                <span>지난 주 대비:</span>
                                <span class={[
                                  "font-bold",
                                  value_color(
                                    @query_result_by_columns[column].meta.diff_between_period_raws
                                  )
                                ]}>
                                  <%= format_number(
                                    @query_result_by_columns[column].meta.diff_between_period_raws
                                  ) %>
                                </span>
                              </p>
                            </section>
                            <section class="border border-gray-200 p-4 rounded-lg flex flex-col gap-y-2">
                              <h4 class="text-xl font-bold">최근 7일 합계</h4>
                              <p class="text-center text-3xl font-bold">
                                <%= format_number(
                                  @query_result_by_columns[column].meta.current_period_sum
                                ) %>
                              </p>
                              <p class="text-xl text-center">
                                <span>WOW:</span>
                                <span class={[
                                  "font-bold",
                                  value_color(
                                    @query_result_by_columns[column].meta.diff_between_period_sums_in_percentage
                                  )
                                ]}>
                                  <%= wow_text(
                                    @query_result_by_columns[column].meta.diff_between_period_sums_in_percentage
                                  ) %>
                                </span>
                              </p>
                            </section>
                          </div>
                          <section
                            id={"chart-container-#{@query_result_by_columns[column].meta.label}"}
                            phx-update="ignore"
                            class="pt-2"
                          >
                            <canvas
                              id={"chart-#{@query_result_by_columns[column].meta.label}"}
                              class="border border-gray-200 rounded-lg"
                              phx-hook="Chart"
                            >
                            </canvas>
                          </section>
                        </section>
                      <% end %>
                    <% end %>
                  </div>
                <% else %>
                  <div class="pt-6">
                    <Empty.empty
                      title="쿼리 결과가 없습니다."
                      description="확인할 데이터를 쿼리해주세요."
                    />
                  </div>
                <% end %>
              </div>
            </section>
          </section>

          <section class="card">
            <div class="card-body">
              <h2 class="card-title">레포트 정보</h2>
              <div class="space-y-4">
                <div class="flex items-center gap-x-2 mt-4">
                  <%= label(f, :name, "레포트 이름", class: "label w-28 text-gray-500 text-sm") %>
                  <%= text_input(f, :name,
                    placeholder: "데일리 유저 지표",
                    class: "input input-bordered w-64",
                    value: input_value(f, :name)
                  ) %>
                  <%= error_tag(f, :name) %>
                </div>

                <div class="flex items-center gap-x-2">
                  <%= label(f, :hour, "레포트 발송 시간", class: "label w-28 text-gray-500 text-sm") %>
                  <%= select(f, :hour, @hours, class: "select select-bordered w-64") %>
                  <%= error_tag(f, :hour) %>
                </div>

                <%= inputs_for f, :integration_info, fn fii -> %>
                  <%= hidden_input(fii, :integration_id) %>

                  <div class="flex items-center gap-x-2">
                    <%= label(fii, :channel_id, "레포트 발송 채널",
                      class: "label w-28 text-gray-500 text-sm"
                    ) %>
                    <%= select(fii, :channel_id, @channels, class: "select select-bordered w-64") %>
                    <a class="ml-1" phx-click="refresh_slack_channel_list">
                      <CarrierWeb.Components.Icon.refresh class={"w-5 h-5 #{if @is_loading_slack_channels, do: "text-gray-100 cursor-not-allowed", else: "cursor-pointer text-neutral-content"}"} />
                    </a>
                    <%= error_tag(f, :channel_id) %>
                  </div>
                <% end %>

                <div class="flex gap-x-4 justify-end">
                  <button
                    class="btn btn-outline"
                    type="button"
                    phx-click={show_modal("send-preview")}
                    disabled={!@data_loaded}
                  >
                    테스트 발송
                  </button>
                  <%= submit("레포트 저장",
                    class: "btn btn-primary",
                    disabled: !@report_changeset.valid?
                  ) %>
                </div>
              </div>
            </div>
          </section>
        </div>
      </.form>
    </div>
  </section>
</section>

<.modal id="send-preview">
  <div>
    <h3 class="font-bold text-lg">테스트 발송</h3>
    <.form
      :let={f}
      for={:send_preview_form}
      id="send_preview_form"
      phx-submit="send_preview"
      autocomplete="off"
      class="space-y-4"
    >
      <div class="flex items-center gap-x-2">
        <%= label(f, :channel, "레포트 발송 채널", class: "label w-36 text-gray-500 text-sm") %>
        <%= select(f, :channel, @channels, class: "select select-bordered w-64") %>
        <%= error_tag(f, :channel) %>
      </div>
      <div class="flex justify-end">
        <%= submit("발송", class: "btn btn-primary text-right") %>
      </div>
    </.form>
  </div>
</.modal>

<.modal id="query-maker">
  <div class="mt-6">
    <.form
      :let={f}
      for={:query_maker_form}
      autocomplete="off"
      class="space-y-4"
      phx-submit="create_query"
    >
      <div class="flex items-center gap-x-2">
        <%= label(f, :table, "테이블", class: "label w-20 text-gray-500 text-sm") %>
        <%= select(f, :table, @tables,
          class: "select select-bordered w-60",
          prompt: [key: "테이블을 선택해주세요", disabled: true, selected: true],
          phx_change: "change_table"
        ) %>
        <%= error_tag(f, :table) %>
      </div>

      <div class="flex items-center gap-x-2">
        <%= label(f, :date_column, "날짜 컬럼", class: "label w-20 text-gray-500 text-sm") %>
        <%= select(f, :date_column, @date_columns,
          class: "select select-bordered w-60",
          selected: @date_columns |> List.first()
        ) %>
        <%= error_tag(f, :date_column) %>
        <%= if length(@date_columns) == 0 do %>
          <div class="text-red-500 text-sm">선택하신 테이블에 날짜 컬럼이 없습니다.</div>
        <% end %>
      </div>

      <div class="flex items-center gap-x-2">
        <%= label(f, :value_column_name, "지표 컬럼", class: "label w-20 text-gray-500 text-sm") %>
        <%= select(f, :aggregation, @aggregations,
          class: "select select-bordered w-60",
          selected: @aggregations |> List.first()
        ) %>
        <%= select(f, :value_column, @value_columns,
          class: "select select-bordered w-60",
          selected: @value_columns |> List.first()
        ) %>
        <%= text_input(f, :value_column_name,
          placeholder: "보여줄 컬럼 이름",
          class: "input input-bordered w-60",
          value: input_value(f, :value_column_name)
        ) %>
        <%= error_tag(f, :value_column) %>
      </div>

      <%!-- <div class="divider" />

  <div>
    <table class="table mt-4 w-full">
      <thead>
        <tr class="w-full">
          <th class="text-center py-3">header</th>
          <th class="text-center py-3">header</th>
          <th class="text-center py-3">header</th>
        </tr>
      </thead>
      <tbody>
        <tr class="w-full">
          <td class="text-center py-2 text-sm bg-base-300">value</td>
          <td class="text-center py-2 text-sm bg-base-300">value</td>
          <td class="text-center py-2 text-sm bg-base-300">value</td>
        </tr>
      </tbody>
    </table>
  </div> --%>

      <div class="mt-12">
        <button type="submit" class="w-full btn btn-primary">
          쿼리 생성
        </button>
      </div>
    </.form>
  </div>
</.modal>
