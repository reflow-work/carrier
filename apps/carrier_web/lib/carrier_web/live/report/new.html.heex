<section class="page-container">
  <header class="page-header">
    <h1 class="page-title">
      <span class="page-title-icon">📊</span> 레포트 생성하기
    </h1>
  </header>

  <section class="mt-6 space-y-6">
    <section class="card">
      <div class="card-body">
        <div>
          <h2 class="card-title mb-3">데이터 소스 선택하기</h2>
          <div>
            데이터를 불러올 데이터 소스를 선택해주세요.
          </div>
        </div>

        <.form :let={f} for={:data_source} phx-change="select_data_source">
          <div class="flex items-center gap-x-2 mt-4">
            <%= label(f, :id, "데이터 소스 이름", class: "label w-28 text-gray-500 text-sm") %>
            <%= select(
              f,
              :id,
              @data_source_options,
              class: "select select-bordered w-64",
              selected: @data_source |> Nillable.map(& &1.id)
            ) %>
          </div>
        </.form>
      </div>
    </section>
    <%= if @data_source.source in [:postgres, :mysql, :bigquery, :athena] do %>
      <section class="card">
        <div class="card-body">
          <div class="flex justify-between">
            <div>
              <h2 class="card-title mb-3">쿼리 입력하기</h2>
              <div>
                ☝️ 기준이 되는 날짜 컬럼과 보고 싶은 지표 컬럼(최대 3개)을 쿼리해주세요.
              </div>
            </div>

            <%= if @data_source.source in [:postgres, :mysql] do %>
              <label
                for="query-maker"
                class="btn btn-primary ml-2"
                phx-click="open_query_maker"
                style={"font-size:#{@query_maker_button_font_size}px;"}
              >
                <CarrierWeb.Components.Icon.package class="w-6 h-6 mr-3" /> 간단한 쿼리 자동 입력기
              </label>
            <% end %>
          </div>

          <.form
            :let={f}
            for={:query}
            phx-change="validate_query"
            phx-submit="run_query"
            autocomplete="off"
          >
            <div class="flex-col gap-2 sm:grid sm:grid-cols-7 sm:gap-2 pt-2">
              <div class="sm:col-span-4">
                <%= textarea(f, :sql_template,
                  class: "border rounded query w-full",
                  placeholder: @sample_sql_template,
                  value: @sql_template,
                  rows: 16
                ) %>
                <%= if @query_error_message do %>
                  <div class="text-red-500 text-sm mt-1">
                    <%= @query_error_message %>
                  </div>
                <% end %>
              </div>
              <section class="w-full px-2 sm:col-span-3 text-sm">
                <QueryChecker.checker checked={@query_validations.contains_start}>
                  <b>기간 시작 조건</b>에 실제 날짜가 아닌 <code class="code">{{start}}</code>를 넣어주세요.
                </QueryChecker.checker>

                <QueryChecker.checker class="mt-2" checked={@query_validations.contains_end}>
                  <b>기간 종료 조건</b>에 실제 날짜가 아닌 <code class="code">{{end}}</code>를 넣어주세요.
                </QueryChecker.checker>

                <div class="bg-yellow-50 rounded p-3 mt-3">
                  <b>📌 Check point</b>

                  <p class="mt-2">
                    - SELECT문의 첫 번째 컬럼에 <b>DATE 타입</b>의 기준이 되는 날짜 컬럼을 넣어주세요.
                  </p>

                  <p class="mt-2">
                    - SELECT문의 두 번째 컬럼부터는 <b>지표 컬럼</b>을 넣어주세요.
                  </p>

                  <p class="mt-2">
                    - <code class="code">AS "표시할 이름"</code>을 통해 지정한 지표 컬럼의 이름대로 레포트 제목이 생성됩니다.
                  </p>

                  <p class="mt-2">
                    - 집계된 데이터가 담긴 테이블이 아닌 경우 기준이 되는 날짜로 GROUP BY한 집계 쿼리를 작성해주세요.
                  </p>
                </div>
              </section>
            </div>
            <div class="text-right mt-2">
              <%= submit("쿼리 실행",
                class: "btn btn-primary",
                disabled: !is_valid_sql_template(@query_validations)
              ) %>
            </div>
          </.form>
          <%= render_query_preview(assigns) %>
        </div>
      </section>
    <% end %>
    <%= if @data_source.source == :tableau do %>
      <section class="card">
        <div class="card-body">
          <div>
            <h2 class="card-title mb-3">Tableau View 선택하기</h2>
            <div>
              Tableau 에서 불러올 View 를 선택해주세요.
            </div>
          </div>
          <div>
            <.form :let={f} for={:tableau_view} autocomplete="off">
              <div class="flex items-center gap-x-2 mt-4">
                <%= label(f, :tableau_view_search_term, "View 이름",
                  class: "label w-28 text-gray-500 text-sm"
                ) %>
                <div class="relative" phx-click-away="clear_tableau_view_suggestions">
                  <%= text_input(f, :tableau_view_search_term,
                    placeholder: "Tableau View 이름을 입력해주세요.",
                    class: "input input-bordered w-64",
                    value: @tableau_view_search_term,
                    phx_change: "search_tableau_view",
                    phx_focus: "search_tableau_view"
                  ) %>
                  <%= if (!Enum.empty?(@tableau_view_suggestions)) do %>
                    <ul class="absolute max-h-64 bottom-[50px] border border-gray-400 divide-y divide-y-gray400 w-64 bg-white overflow-y-auto overflow-x-clip rounded-lg">
                      <%= for %{id: id, full_name: full_name} <- @tableau_view_suggestions do %>
                        <li>
                          <button
                            class="w-64 p-2 hover:bg-gray-200 text-left text-sm"
                            phx-click={JS.push("select_tableau_view", value: %{id: id})}
                            type="button"
                          >
                            <%= "#{full_name}" %>
                          </button>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </div>
              </div>
            </.form>
          </div>
        </div>
      </section>
    <% end %>

    <%= if @data_source.source in [:postgres, :mysql, :bigquery, :athena] do %>
      <div>
        <.form
          :let={f}
          for={@report_changeset}
          as={:report}
          phx-change="validate_report"
          phx-submit="save_report"
          autocomplete="off"
        >
          <%= hidden_input(f, :org_id, value: @org_id) %>
          <%= hidden_input(f, :user_id, value: @user_id) %>

          <div class="space-y-6">
            <section class="flex gap-4 flex-col lg:flex-row">
              <section class="card flex-[3_3_0%]">
                <div class="card-body">
                  <section>
                    <h2 class="card-title">레포트 설정</h2>
                    <%!-- <section>
                    <h3 class="font-bold mt-6">레포트 옵션</h3>
                    <%= if @data_loaded do %>
                      <div class="flex flex-col gap-y-3 mt-2">
                        <div class="flex gap-x-2 items-center">
                          <input type="checkbox" value="chart" />
                          <label>텍스트</label>
                        </div>
                        <div class="flex gap-x-2 items-center">
                          <input type="checkbox" value="chart" />
                          <label>테이블</label>
                        </div>
                        <div class="flex gap-x-2 items-center">
                          <input type="checkbox" value="chart" />
                          <label>차트</label>
                        </div>
                      </div>
                    <% else %>
                      <div class="pt-6">
                        <Empty.empty
                          title="쿼리 결과가 없습니다."
                          description="확인할 데이터를 쿼리해주세요."
                        />
                      </div>
                    <% end %>
                  </section> --%>

                    <section>
                      <h3 class="font-bold mt-6">레포트를 발송할 지표</h3>
                      <%= if @data_loaded do %>
                        <div class="flex flex-col gap-y-3 mt-2">
                          <%= inputs_for f, :data_source_info, fn fdsi -> %>
                            <%= hidden_input(fdsi, :data_source_id, value: @data_source.id) %>
                            <%= hidden_input(fdsi, :source, value: @data_source.source) %>
                            <%= hidden_input(fdsi, :sql_template, value: @sql_template) %>
                            <%= hidden_input(fdsi, :timezone, value: @timezone) %>
                            <%= hidden_input(fdsi, :period, value: @period) %>
                            <%= hidden_input(fdsi, :comparing_period, value: @comparing_period) %>

                            <%= for column <- @columns do %>
                              <div class="flex gap-x-2 items-center">
                                <input
                                  type="checkbox"
                                  name="report[data_source_info][columns][]"
                                  value={column}
                                  checked={column in @selected_columns}
                                />
                                <%= label(fdsi, :columns, column) %>
                              </div>
                            <% end %>
                          <% end %>
                        </div>
                      <% else %>
                        <div class="pt-6">
                          <Empty.empty
                            title="쿼리 결과가 없습니다."
                            description="확인할 데이터를 쿼리해주세요."
                          />
                        </div>
                      <% end %>
                    </section>
                  </section>
                  <section>
                    <h3 class="font-bold mt-10">그래프 값 옵션</h3>
                    <%= if @data_loaded do %>
                      <div class="flex flex-col mt-2">
                        <%= inputs_for f, :data_source_info, fn fdsi -> %>
                          <div class="flex gap-x-2 items-center">
                            <%= radio_button(fdsi, :window_size, 1,
                              class: "radio",
                              phx_click: "select_window_size",
                              selected: @window_size === 1
                            ) %>
                            <%= label(f, :window_size, "당일 지표") %>
                          </div>
                          <div class="text-sm text-gray-500 ml-6 mt-1">
                            당일의 지표를 추가적인 집계 없이 그래프에 표시합니다.
                          </div>

                          <div class="flex gap-x-2 items-center mt-4">
                            <%= radio_button(fdsi, :window_size, 7,
                              class: "radio",
                              phx_click: "select_window_size",
                              selected: @window_size === 7
                            ) %>
                            <%= label(f, :window_size, "이동합계") %>
                          </div>
                          <div class="text-sm text-gray-500 ml-6 mt-1">
                            요일별 추이를 제거하고 보기위해 최근 7일간의 합계로 그래프에 표시합니다.
                          </div>
                        <% end %>
                      </div>
                    <% else %>
                      <div class="pt-6">
                        <Empty.empty
                          title="쿼리 결과가 없습니다."
                          description="확인할 데이터를 쿼리해주세요."
                        />
                      </div>
                    <% end %>
                  </section>
                </div>
              </section>

              <section class="card flex-[7_7_0%]">
                <div class="card-body">
                  <h2 class="card-title">슬랙 미리보기</h2>
                  <%= if @data_loaded do %>
                    <div class="w-[500px] flex flex-col gap-y-6 mt-4">
                      <%!-- <div>
                      <pre class="font-mono border text-sm border-slack-code-border bg-slack-code-bg p-4 rounded-md max-w-xl">
날짜            신규 유저수       매출            결제수
------------   ------------   ------------   ------------
2023.03.19     320            7800000        2012
2023.03.20     331            9110000        2221
2023.03.21     340            3320000        1231
2023.03.22     504            4500000        1605
2023.03.23     640            99400000       3402</pre>
                    </div> --%>
                      <%= for column <- @selected_columns do %>
                        <section class={"space-y-3 bg-slackImgLightGrey p-4 #{if column not in @selected_columns, do: "hidden"}"}>
                          <h3 class="font-bold text-base-dark text-sm">
                            📊 <%= "#{current_datetime!(@timezone) |> DateHelper.safe_format_date()} - #{@query_result_by_columns[column].meta.label}" %>
                          </h3>
                          <div class="grid grid-cols-2 py-4 px-5 rounded-lg shadow-slackImgSection bg-white divide-x-2 divide-slackImgLightGrey">
                            <section>
                              <h4 class="text-xs font-bold text-slackImgGrey">어제</h4>
                              <p class="text-xl font-bold mt-2">
                                <%= format_number(
                                  @query_result_by_columns[column].meta.current_period_last_tick_raw
                                ) %>
                              </p>
                              <div class="flex space-x-2 mt-1">
                                <SlackImgMetaData.card
                                  diff_value_raw={
                                    @query_result_by_columns[column].meta.diff_between_period_raws
                                  }
                                  diff_value_percentage={
                                    @query_result_by_columns[column].meta.diff_between_period_raws_in_percentage
                                  }
                                />
                              </div>
                            </section>
                            <section class="pl-5">
                              <h4 class="text-xs font-bold text-slackImgGrey">최근 7일 합계</h4>
                              <p class="text-xl font-bold mt-2">
                                <%= format_number(
                                  @query_result_by_columns[column].meta.current_period_sum
                                ) %>
                              </p>
                              <div class="flex space-x-2 mt-1">
                                <SlackImgMetaData.card
                                  diff_value_raw={
                                    @query_result_by_columns[column].meta.diff_between_period_sums
                                  }
                                  diff_value_percentage={
                                    @query_result_by_columns[column].meta.diff_between_period_sums_in_percentage
                                  }
                                />
                              </div>
                            </section>
                          </div>
                          <section
                            id={"chart-container-#{@query_result_by_columns[column].meta.label}"}
                            phx-update="ignore"
                            class="h-[250px]"
                          >
                            <canvas
                              id={"chart-#{@query_result_by_columns[column].meta.label}"}
                              class="rounded-lg shadow-slackImgSection"
                              phx-hook="Chart"
                            >
                            </canvas>
                          </section>
                        </section>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="pt-6">
                      <Empty.empty
                        title="쿼리 결과가 없습니다."
                        description="확인할 데이터를 쿼리해주세요."
                      />
                    </div>
                  <% end %>
                </div>
              </section>
            </section>

            <section class="card overflow-auto">
              <div class="card-body">
                <h2 class="card-title">레포트 정보</h2>
                <div class="space-y-4">
                  <div class="flex items-center gap-x-2 mt-4">
                    <%= label(f, :name, "레포트 이름", class: "label w-28 text-gray-500 text-sm") %>
                    <%= text_input(f, :name,
                      placeholder: "데일리 유저 지표",
                      class: "input input-bordered w-64",
                      value: @report_name
                    ) %>
                    <%= error_tag(f, :name) %>
                  </div>

                  <div class="flex items-center gap-x-2">
                    <%= label(f, :hour, "레포트 발송 시간", class: "label w-28 text-gray-500 text-sm") %>
                    <%= select(f, :hour, @hours,
                      selected: @hour,
                      class: "select select-bordered w-64"
                    ) %>
                    <%= error_tag(f, :hour) %>
                  </div>

                  <%= inputs_for f, :integration_info, fn fii -> %>
                    <%= hidden_input(fii, :integration_id, value: @integration.id) %>
                    <%= hidden_input(fii, :channel_id, value: @channel_id) %>

                    <div id="integration_info" class="flex items-center gap-x-2">
                      <%= label(fii, :channel_search_term, "레포트 발송 채널",
                        class: "label w-28 text-gray-500 text-sm"
                      ) %>
                      <div class="relative" phx-click-away="clear_channel_suggestions">
                        <%= text_input(fii, :channel_search_term,
                          class: "input input-bordered w-64",
                          value: @channel_search_term,
                          phx_change: "search_slack_channels",
                          phx_focus: "search_slack_channels"
                        ) %>
                        <%= if (!Enum.empty?(@channel_suggestions)) do %>
                          <ul class="absolute max-h-64 bottom-[50px] border border-gray-400 divide-y divide-y-gray400 w-64 bg-white overflow-y-auto overflow-x-clip rounded-lg">
                            <%= for {label, id} <- @channel_suggestions do %>
                              <li>
                                <button
                                  class="w-64 p-2 hover:bg-gray-200 text-left text-sm"
                                  phx-click={
                                    JS.push("select_slack_channel", value: %{channel_id: id})
                                  }
                                  type="button"
                                >
                                  <%= "##{label}" %>
                                </button>
                              </li>
                            <% end %>
                          </ul>
                        <% end %>
                      </div>
                      <a class="ml-1" phx-click="refresh_slack_channel_list">
                        <CarrierWeb.Components.Icon.refresh class={"w-5 h-5 #{if @is_loading_slack_channels, do: "text-gray-100 cursor-not-allowed", else: "cursor-pointer text-neutral-content"}"} />
                      </a>
                      <%= error_tag(f, :channel_id) %>
                    </div>
                  <% end %>

                  <div class="flex gap-x-4 justify-end">
                    <button
                      class="btn btn-outline"
                      type="button"
                      phx-click={show_modal("send-preview")}
                      disabled={!@data_loaded}
                    >
                      테스트 발송
                    </button>
                    <%= submit("레포트 저장",
                      class: "btn btn-primary",
                      disabled: !@report_changeset.valid?
                    ) %>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </.form>
      </div>
    <% end %>
    <%= if @data_source.source == :tableau do %>
      <section class="card">
        <div class="card-body">
          <div>
            <h2 class="card-title mb-3">Tableau View 미리보기</h2>
            <div>
              <%= if @tableau_image_binary do %>
                <img src={"data:image/png;base64,#{@tableau_image_binary}"} />
              <% else %>
                <div class="pt-6">
                  <Empty.empty
                    title="View 가 선택되지 않았습니다."
                    description="확인할 View 를 선택해주세요."
                  />
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </section>
      <section class="card overflow-auto">
        <div class="card-body">
          <h2 class="card-title">레포트 정보</h2>
          <.form
            :let={f}
            for={@report_changeset}
            as={:report}
            phx-change="validate_report"
            phx-submit="save_report"
            autocomplete="off"
          >
            <%= hidden_input(f, :org_id, value: @org_id) %>
            <%= hidden_input(f, :user_id, value: @user_id) %>

            <%= inputs_for f, :data_source_info, fn fdsi -> %>
              <%= hidden_input(fdsi, :data_source_id, value: @data_source.id) %>
              <%= if @tableau_selected_view do %>
                <%= hidden_input(fdsi, :view_id, value: @tableau_selected_view.id) %>
                <%= hidden_input(fdsi, :view_name, value: @tableau_selected_view.full_name) %>
              <% end %>
            <% end %>

            <div class="space-y-4">
              <div class="flex items-center gap-x-2 mt-4">
                <%= label(f, :name, "레포트 이름", class: "label w-28 text-gray-500 text-sm") %>
                <%= text_input(f, :name,
                  placeholder: "데일리 유저 지표",
                  class: "input input-bordered w-64",
                  value: @report_name
                ) %>
                <%= error_tag(f, :name) %>
              </div>

              <div class="flex items-center gap-x-2">
                <%= label(f, :hour, "레포트 발송 시간", class: "label w-28 text-gray-500 text-sm") %>
                <%= select(f, :hour, @hours,
                  selected: @hour,
                  class: "select select-bordered w-64"
                ) %>
                <%= error_tag(f, :hour) %>
              </div>

              <%= inputs_for f, :integration_info, fn fii -> %>
                <%= hidden_input(fii, :integration_id, value: @integration.id) %>
                <%= hidden_input(fii, :channel_id, value: @channel_id) %>

                <div id="integration_info" class="flex items-center gap-x-2">
                  <%= label(fii, :channel_search_term, "레포트 발송 채널",
                    class: "label w-28 text-gray-500 text-sm"
                  ) %>
                  <div class="relative" phx-click-away="clear_channel_suggestions">
                    <%= text_input(fii, :channel_search_term,
                      class: "input input-bordered w-64",
                      value: @channel_search_term,
                      phx_change: "search_slack_channels",
                      phx_focus: "search_slack_channels"
                    ) %>
                    <%= if (!Enum.empty?(@channel_suggestions)) do %>
                      <ul class="absolute max-h-64 bottom-[50px] border border-gray-400 divide-y divide-y-gray400 w-64 bg-white overflow-y-auto overflow-x-clip rounded-lg">
                        <%= for {label, id} <- @channel_suggestions do %>
                          <li>
                            <button
                              class="w-64 p-2 hover:bg-gray-200 text-left text-sm"
                              phx-click={
                                JS.push("select_slack_channel", value: %{channel_id: id})
                              }
                              type="button"
                            >
                              <%= "##{label}" %>
                            </button>
                          </li>
                        <% end %>
                      </ul>
                    <% end %>
                  </div>
                  <a class="ml-1" phx-click="refresh_slack_channel_list">
                    <CarrierWeb.Components.Icon.refresh class={"w-5 h-5 #{if @is_loading_slack_channels, do: "text-gray-100 cursor-not-allowed", else: "cursor-pointer text-neutral-content"}"} />
                  </a>
                  <%= error_tag(f, :channel_id) %>
                </div>
              <% end %>

              <div class="flex gap-x-4 justify-end">
                <button
                  class="btn btn-outline"
                  type="button"
                  phx-click={show_modal("send-preview")}
                  disabled={!@data_loaded}
                >
                  테스트 발송
                </button>
                <%= submit("레포트 저장",
                  class: "btn btn-primary",
                  disabled: !@report_changeset.valid?
                ) %>
              </div>
            </div>
          </.form>
        </div>
      </section>
    <% end %>
  </section>
</section>

<.modal id="send-preview">
  <div>
    <h3 class="font-bold text-lg">테스트 발송</h3>
    <.form
      :let={f}
      for={:send_preview_form}
      id="send_preview_form"
      phx-submit="send_preview"
      autocomplete="off"
      class="space-y-4"
    >
      <div class="flex items-center gap-x-2">
        <%= label(f, :channel, "레포트 발송 채널", class: "label w-36 text-gray-500 text-sm") %>
        <%= select(f, :channel, @channels, class: "select select-bordered w-64") %>
        <%= error_tag(f, :channel) %>
      </div>
      <div class="flex justify-end">
        <%= submit("발송", class: "btn btn-primary text-right") %>
      </div>
    </.form>
  </div>
</.modal>

<.modal id="query-maker">
  <div class="mt-6">
    <.form
      :let={f}
      for={:query_maker_form}
      autocomplete="off"
      class="space-y-4"
      phx-submit="create_query"
    >
      <div class="flex items-center gap-x-2">
        <%= label(f, :table, "테이블", class: "label w-20 text-gray-500 text-sm") %>
        <%= select(f, :table, @tables,
          class: "select select-bordered w-60",
          prompt: [key: "테이블을 선택해주세요", disabled: true, selected: true],
          phx_change: "change_table"
        ) %>
        <%= error_tag(f, :table) %>
      </div>

      <div class="flex items-center gap-x-2">
        <%= label(f, :date_column, "날짜 컬럼", class: "label w-20 text-gray-500 text-sm") %>
        <%= select(f, :date_column, @date_columns,
          class: "select select-bordered w-60",
          selected: @date_columns |> List.first()
        ) %>
        <%= error_tag(f, :date_column) %>
        <%= if length(@date_columns) == 0 do %>
          <div class="text-red-500 text-sm">선택하신 테이블에 날짜 컬럼이 없습니다.</div>
        <% end %>
      </div>

      <div class="flex items-center gap-x-2">
        <%= label(f, :value_column_name, "지표 컬럼", class: "label w-20 text-gray-500 text-sm") %>
        <%= select(f, :value_column, @value_columns,
          class: "select select-bordered w-60",
          selected: @value_columns |> List.first()
        ) %>
        <%= select(f, :aggregation, @aggregations,
          class: "select select-bordered w-60",
          selected: @aggregations |> List.first()
        ) %>
        <%= text_input(f, :value_column_name,
          placeholder: "보여줄 컬럼 이름",
          class: "input input-bordered w-60",
          value: input_value(f, :value_column_name)
        ) %>
        <%= error_tag(f, :value_column) %>
      </div>

      <%!-- <div class="divider" />

<div>
  <table class="table mt-4 w-full">
   <thead>
      <tr class="w-full">
        <th class="text-center py-3">header</th>
      <th class="text-center py-3">header</th>
    <th class="text-center py-3">header</th>
  </tr>
</thead>
<tbody>
      <tr class="w-full">
        <td class="text-center py-2 text-sm bg-base-300">value</td>
        <td class="text-center py-2 text-sm bg-base-300">value</td>
      <td class="text-center py-2 text-sm bg-base-300">value</td>
    </tr>
  </tbody>
</table>
</div> --%>

      <div class="mt-12">
        <button type="submit" class="w-full btn btn-primary">
          쿼리 생성
        </button>
      </div>
    </.form>
  </div>
</.modal>
