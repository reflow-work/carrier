<section class="page-container">
  <header class="page-header">
    <h1 class="page-title">
      <span class="pr-1">📊</span> Create New Report
    </h1>
  </header>

  <section class="mt-6 space-y-6">
    <section class="card">
      <div class="card-body">
        <h2 class="card-title">Type Query</h2>

        <.form let={f} for={:query} id="query_form" phx-submit="run_query" autocomplete="off">
          <%= textarea(f, :sql_template,
            class: "border border-black rounded mt-2 p-2 w-full",
            placeholder: "SQL here",
            value: @sql_template,
            rows: 12
          ) %>
          <div class="text-right mt-2">
            <%= submit("Run Query", class: "btn btn-primary") %>
          </div>
        </.form>
      </div>
    </section>

    <section class="flex gap-8 sm:flex-col">
      <section class="card">
        <div class="card-body">
          <h2 class="card-title">Set up Report</h2>
          <%= if @query_result_parsed do %>
            <.form let={f} for={:data_columns} phx-change="select_data_column" class="gap-y-2">
              <%= for v <- Map.values(@query_result_parsed) do %>
                <div class="flex gap-x-[0.25rem] items-center">
                  <%= label(f, v.meta.label, v.meta.label) %>
                  <%= checkbox(f, v.meta.label,
                    value: Enum.member?(@selected_columns, v.meta.label)
                  ) %>
                </div>
              <% end %>
            </.form>
          <% else %>
            <p>Need data!</p>
          <% end %>
        </div>
      </section>

      <section class="card">
        <div class="card-body">
          <h2 class="card-title">Slack Preview</h2>
          <%= if @query_result_parsed do %>
            <%= for v <- Map.values(@query_result_parsed) do %>
              <%= if Enum.member?(@selected_columns, v.meta.label) do %>
                <section class="rounded-xl border border-gray-200 p-6 font-lato text-slackBody mt-6">
                  <h3 class="font-bold pb-2">📊 <%= v.meta.label %></h3>
                  <section class="divide-y divide-gray-200">
                    <section>
                      <p class="font-bold py-2">Raw</p>
                      <section class="grid grid-cols-2 grid-rows-2 py-2">
                        <p class="font-bold">Yesterday</p>
                        <p class="font-bold">Last Week</p>
                        <p><%= v.meta.current_period_last_tick_raw %></p>
                        <p><%= v.meta.previous_period_last_tick_raw %></p>
                      </section>
                      <p class="font-bold py-2">Weekly Sum</p>
                      <section class="grid grid-cols-2 grid-rows-2 py-2">
                        <p class="font-bold">Last Week</p>
                        <p class="font-bold">Week over Week</p>
                        <p><%= v.meta.current_period_sum %></p>
                        <p><%= "#{v.meta.diff_between_periods_in_percentage}%" %></p>
                      </section>
                    </section>
                    <section
                      id={"chart-container-#{v.meta.label}"}
                      phx-update="ignore"
                      class="pt-2"
                    >
                      <canvas
                        id={"chart-#{v.meta.label}"}
                        class="border border-gray-200 rounded-lg"
                        phx-hook="Chart"
                      >
                      </canvas>
                    </section>
                  </section>
                </section>
              <% else %>
                <div></div>
              <% end %>
            <% end %>
          <% else %>
            <p>Need data!</p>
          <% end %>
        </div>
      </section>
    </section>
    <section class="card">
      <div class="card-body">
        <h2 class="card-title">Report Details</h2>
        <.form
          let={f}
          for={:report}
          id="report_form"
          phx-submit="save_report"
          autocomplete="off"
          class="space-y-2"
        >
          <div class="flex items-center gap-x-2">
            <%= label(f, :name, "Name", class: "label") %>
            <%= text_input(f, :name,
              placeholder: "Daily User Metric",
              class: "input input-bordered"
            ) %>
            <%= error_tag(f, :name) %>
          </div>

          <div class="flex items-center gap-x-2">
            <%= label(f, :hour, "Hour", class: "label") %>
            <%= select(f, :hour, @hours, class: "select select-bordered") %>
            <%= error_tag(f, :hour) %>
          </div>

          <div class="flex items-center gap-x-2">
            <%= label(f, :channel, "Channel", class: "label") %>
            <%= select(f, :channel, @channels, class: "select select-bordered") %>
            <%= error_tag(f, :channel) %>
          </div>

          <div class="flex gap-x-4 justify-end">
            <button class="btn btn-outline" type="button" phx-click="send_preview">
              Send Preview
            </button>
            <%= submit("Save", class: "btn btn-primary") %>
          </div>
        </.form>
      </div>
    </section>
  </section>

  <div>
    <a
      href="https://slack.com/oauth/v2/authorize?scope=channels%3Aread&amp;user_scope=&amp;redirect_uri=&amp;client_id=3700242262145.3907206908336"
      style="align-items:center;color:#000;background-color:#fff;border:1px solid #ddd;border-radius:4px;display:inline-flex;font-family:Lato, sans-serif;font-size:14px;font-weight:600;height:44px;justify-content:center;text-decoration:none;width:204px"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        style="height:16px;width:16px;margin-right:12px"
        viewBox="0 0 122.8 122.8"
      ><path
  d="M25.8 77.6c0 7.1-5.8 12.9-12.9 12.9S0 84.7 0 77.6s5.8-12.9 12.9-12.9h12.9v12.9zm6.5 0c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9v32.3c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V77.6z"
  fill="#e01e5a"
></path><path
  d="M45.2 25.8c-7.1 0-12.9-5.8-12.9-12.9S38.1 0 45.2 0s12.9 5.8 12.9 12.9v12.9H45.2zm0 6.5c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H12.9C5.8 58.1 0 52.3 0 45.2s5.8-12.9 12.9-12.9h32.3z"
  fill="#36c5f0"
></path><path
  d="M97 45.2c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9-5.8 12.9-12.9 12.9H97V45.2zm-6.5 0c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V12.9C64.7 5.8 70.5 0 77.6 0s12.9 5.8 12.9 12.9v32.3z"
  fill="#2eb67d"
></path><path
  d="M77.6 97c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9-12.9-5.8-12.9-12.9V97h12.9zm0-6.5c-7.1 0-12.9-5.8-12.9-12.9s5.8-12.9 12.9-12.9h32.3c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H77.6z"
  fill="#ecb22e"
></path></svg>Add to Slack
    </a>
  </div>
</section>
