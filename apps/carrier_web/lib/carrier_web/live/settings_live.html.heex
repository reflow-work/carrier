<section class="page-container">
  <header class="page-header">
    <h1 class="page-title">
      <span class="page-title-icon">⚙️</span> 설정
    </h1>
  </header>

  <div class="space-y-8 mt-6">
    <div class="card">
      <div class="card-body">
        <h2 class="card-title">
          계정 정보
        </h2>

        <p>
          <%= @user.email %>
        </p>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <h2 class="card-title">
          구독 정보
        </h2>

        <p>
          Trial
        </p>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <.link
          href={Routes.auth_path(@socket, :logout)}
          phx-click="smartlook_anonymize"
          class="btn"
        >
          로그아웃
        </.link>
      </div>
    </div>
  </div>
</section>
