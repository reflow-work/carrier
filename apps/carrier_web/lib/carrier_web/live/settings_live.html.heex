<section class="page-container">
  <header class="page-header">
    <h1 class="page-title">
      <span class="page-title-icon">⚙️</span> Settings
    </h1>
  </header>

  <div class="space-y-8 mt-10">
    <div class="card">
      <div class="card-body">
        <h2 class="card-title">
          Account
        </h2>

        <p>
          <%= @user.email %>
        </p>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <h2 class="card-title">
          My Plan
        </h2>

        <p>
          Trial
        </p>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <%= link to: Routes.auth_path(@socket, :logout), "phx-click": "smartlook_anonymize", class: "btn" do %>
          Logout
        <% end %>
      </div>
    </div>
  </div>
</section>
