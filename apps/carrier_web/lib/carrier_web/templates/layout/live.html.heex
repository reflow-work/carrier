<main class="bg-base">
  <.flash flash={@flash} />
  <div class="fixed w-20 top-0 bottom-0 bg-base-dark">
    <nav class="flex h-full text-white flex-col items-center py-4">
      <%= live_redirect to: Routes.report_index_path(@socket, :index), class: "p-4" do %>
        <%= img_tag(Routes.static_path(@socket, "/images/logo-white.png"), class: "w-5") %>
      <% end %>

      <%= live_redirect to: Routes.report_index_path(@socket, :index), class: "p-4" do %>
        <Icon.bar_chart />
      <% end %>

      <a class="p-4 cursor-pointer"><Icon.settings /></a>

      <%= link to: Routes.auth_path(@socket, :logout), class: "p-4 cursor-pointer" do %>
        Logout
      <% end %>
    </nav>
  </div>

  <div class="ml-20 h-screen">
    <%= @inner_content %>
  </div>
</main>
