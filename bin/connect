ENV=$1

case $ENV in
    prod)
        HOST="ec2-user@ec2-15-165-126-27.ap-northeast-2.compute.amazonaws.com"
        ;;
    prod-private)
        HOST="ec2-user@10.50.40.87"
        ;;
    # staging)
    #     HOST="ec2-user@ec2-13-125-193-39.ap-northeast-2.compute.amazonaws.com"
    #     ;;
    *)
        echo "wrong env $ENV"
        exit 0
        ;;
esac

CERT_PATH="~/.ssh/carrier_app_deployer.pem"

ssh -i $CERT_PATH $HOST
